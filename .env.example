# Placeholders only. Copy to ignored .env; never commit the populated file.
# Container paths below refer to files beneath the persistent host data folder.
JOBSFINDER_DATA_DIR=./data
JOBSFINDER_PROFILE=/app/data/private/profile.json
JOBSFINDER_CANDIDATES=/app/data/private/candidates.json
JOBSFINDER_REPORT_DIR=/app/data/reports
GEMINI_API_KEY=
GEMINI_PRELIMINARY_MODEL=gemini-3.5-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
# Maximum requests per invocation and Pacific day (not dollars). Keep disabled.
GEMINI_MAX_CALLS=0
GEMINI_BATCH_ENABLED=false
GEMINI_BATCH_MODEL=gemini-3.5-flash-lite
GEMINI_BATCH_SIZE=10
GEMINI_BATCH_INPUT_TOKENS=24000
GEMINI_BATCH_OUTPUT_TOKENS=24576
GEMINI_BATCH_JOB_OUTPUT_TOKENS=1600
GEMINI_TOKEN_COUNT_MODE=near_limit
GEMINI_DAILY_LIMIT=500
GEMINI_RETRY_RESERVE=2
# Set these from the project's actual AI Studio quotas before any activation.
GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_SESSION_BATCHES=8
LOCAL_UID=1000
LOCAL_GID=1000
# Email is exclusively to your one personal recipient. STARTTLS 587 or SSL 465.
# For Gmail use an app password with 2-step verification, never your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
