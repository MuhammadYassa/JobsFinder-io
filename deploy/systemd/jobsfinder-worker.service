[Unit]
Description=JobsFinder monitoring and screening tick
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/jobsfinder
ConditionPathExists=/var/lib/jobsfinder/current.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/jobsfinder/host.py tick
TimeoutStartSec=infinity
UMask=0077
StandardOutput=append:/var/log/jobsfinder/worker.log
StandardError=append:/var/log/jobsfinder/worker.log
