[Unit]
Description=Check for CI-approved JobsFinder release
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/jobsfinder

[Service]
Type=oneshot
EnvironmentFile=/etc/jobsfinder/deploy.env
ExecStart=/usr/bin/python3 /opt/jobsfinder/host.py update
TimeoutStartSec=20min
UMask=0077
StandardOutput=append:/var/log/jobsfinder/update.log
StandardError=append:/var/log/jobsfinder/update.log
